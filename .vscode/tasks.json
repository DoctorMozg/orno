{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo: build workspace",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--workspace"],
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "clear": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "cargo: clippy (deny warnings)",
      "type": "shell",
      "command": "cargo",
      "args": [
        "clippy",
        "--workspace",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "problemMatcher": ["$rustc"],
      "group": "build",
      "presentation": {
        "clear": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "cargo: test workspace",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--workspace", "--all-targets"],
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "clear": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "cargo: all linters",
      "type": "shell",
      "command": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo deny check && typos && cargo machete",
      "problemMatcher": ["$rustc"],
      "group": "test",
      "presentation": {
        "clear": true,
        "reveal": "always",
        "panel": "shared",
        "echo": true
      }
    },
    {
      "label": "orno: run commit-digest example",
      "type": "shell",
      "command": "cargo run -p orno-cli -- run examples/commit-digest.yaml --secrets-file .env.secrets -v 2>&1",
      "options": {
        "env": {
          "RUST_LOG": "info"
        }
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "clear": true,
        "reveal": "always",
        "panel": "shared",
        "echo": true
      }
    },
    {
      "label": "orno: run mcp-http-demo example",
      "type": "shell",
      "command": "cargo run -p orno-cli -- run examples/mcp-http-demo.yaml --secrets-file .env.secrets -v 2>&1",
      "options": {
        "env": {
          "RUST_LOG": "info"
        }
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "clear": true,
        "reveal": "always",
        "panel": "shared",
        "echo": true
      }
    },
    {
      "label": "orno: mcp-http record/replay walkthrough",
      "type": "shell",
      "command": "bash examples/mcp-http-record-replay.sh 2>&1",
      "options": {
        "env": {
          "RUST_LOG": "info"
        }
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "clear": true,
        "reveal": "always",
        "panel": "shared",
        "echo": true
      }
    },
    {
      "label": "orno: plan commit-digest example",
      "type": "shell",
      "command": "cargo run -p orno-cli -- plan examples/commit-digest.yaml 2>&1",
      "problemMatcher": ["$rustc"],
      "presentation": {
        "clear": true,
        "reveal": "always",
        "panel": "shared",
        "echo": true
      }
    },
    {
      "label": "orno: validate commit-digest example",
      "type": "shell",
      "command": "cargo run -p orno-cli -- validate examples/commit-digest.yaml 2>&1",
      "problemMatcher": ["$rustc"],
      "presentation": {
        "clear": true,
        "reveal": "always",
        "panel": "shared",
        "echo": true
      }
    }
  ]
}
